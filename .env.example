# =========================================================================
# SMART YACHT & MARINA MANAGEMENT PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# -------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
WEB_URL=http://localhost:3005
API_BASE_URL=http://localhost:4000/api/v1
ALLOWED_ORIGINS=http://localhost:3005,https://yachtplatform.com

# -------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL & PRISMA)
# -------------------------------------------------------------------------
# Pooled database connection string for production workloads
DATABASE_URL="postgresql://postgres:SecureProdPassword123!@localhost:5432/yacht_platform?schema=public&sslmode=prefer&connection_limit=20&pool_timeout=10"
DIRECT_URL="postgresql://postgres:SecureProdPassword123!@localhost:5432/yacht_platform?schema=public"

# -------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# -------------------------------------------------------------------------
JWT_SECRET=production_jwt_super_secret_key_change_in_prod_987654321
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=production_refresh_token_super_secret_key_123456789
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# -------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (STRIPE)
# -------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_51Mz...
STRIPE_PUBLISHABLE_KEY=pk_test_51Mz...
STRIPE_WEBHOOK_SECRET=whsec_production_webhook_secret_hash_value

# -------------------------------------------------------------------------
# 5. COMMUNICATIONS & NOTIFICATIONS (TWILIO / WHATSAPP / SMTP)
# -------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.production_smtp_password
EMAIL_FROM=noreply@yachtplatform.com

TWILIO_ACCOUNT_SID=AC_production_twilio_account_sid
TWILIO_AUTH_TOKEN=production_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# -------------------------------------------------------------------------
# 6. AI PROVIDER & INTEGRATIONS
# -------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-production_openai_api_key_value
AI_PROVIDER_MODEL=gpt-4o
AI_MAX_TOKENS_PER_DAY=100000

# -------------------------------------------------------------------------
# 7. SMART FLEET & IOT TELEMETRY
# -------------------------------------------------------------------------
IOT_MQTT_BROKER_URL=mqtts://iot.yachtplatform.com:8883
IOT_INGESTION_SECRET=production_iot_telemetry_ingestion_secret
IOT_COOLDOWN_MINUTES=15

# -------------------------------------------------------------------------
# 8. S3 COMPATIBLE FILE STORAGE
# -------------------------------------------------------------------------
STORAGE_DRIVER=s3
AWS_REGION=eu-west-1
AWS_S3_BUCKET=yacht-platform-private-docs
AWS_ACCESS_KEY_ID=AKIA_PRODUCTION_KEY
AWS_SECRET_ACCESS_KEY=production_aws_secret_key_value
