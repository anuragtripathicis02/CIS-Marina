// Prisma Schema for Smart Yacht & Marina Management Platform (Phase 1 & Phase 2 Operations)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  OPS_MANAGER
  BOOKING_MANAGER
  FLEET_MANAGER
  CREW_MANAGER
  FINANCE_MANAGER
  CUSTOMER_SUPPORT
  CONCIERGE
  CREW
  CAPTAIN
  MARINA_MANAGER
  CUSTOMER
  YACHT_OWNER
}

enum BookingStatus {
  INQUIRY
  QUOTE
  PENDING
  RESERVED
  DEPOSIT_PAID
  CONFIRMED
  CONTRACT_PENDING
  CONTRACT_SIGNED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum YachtOperationalStatus {
  ACTIVE
  AVAILABLE
  RESERVED
  BOOKED
  PREPARING
  READY
  IN_CHARTER
  POST_CHARTER
  MAINTENANCE
  OUT_OF_SERVICE
  ARCHIVED
}

enum CrewRole {
  CAPTAIN
  FIRST_OFFICER
  ENGINEER
  CHEF
  STEWARD
  DECKHAND
  OTHER
}

enum CrewStatus {
  AVAILABLE
  ASSIGNED
  ON_CHARTER
  UNAVAILABLE
  ON_LEAVE
  INACTIVE
}

enum CertStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
}

enum MaintenanceStatus {
  REPORTED
  PLANNED
  SCHEDULED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InspectionType {
  PRE_CHARTER
  POST_CHARTER
  MAINTENANCE
  GENERAL
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
  CANCELLED
}

enum InspectionItemResult {
  PASS
  FAIL
  NOT_CHECKED
  NOT_APPLICABLE
}

enum ChecklistStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ChecklistItemResult {
  PENDING
  COMPLETED
  FAILED
  NOT_APPLICABLE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum Currency {
  USD
  EUR
  AED
  GBP
  INR
  AUD
  SGD
  JPY
  CAD
}

enum BusinessType {
  YACHT_CHARTER
  YACHT_OPERATOR
  YACHT_BROKER
  MARINA
  YACHT_CLUB
  LUXURY_EVENT
  OTHER
}

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  legalName       String?  @map("legal_name")
  taxId           String?  @map("tax_id")
  countryCode     String   @map("country_code")
  defaultCurrency Currency @default(USD) @map("default_currency")
  timezone        String   @default("UTC")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  locations          Location[]
  users              User[]
  yachts             Yacht[]
  customers          Customer[]
  bookings           Booking[]
  payments           Payment[]
  invoices           Invoice[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  crewMembers        CrewMember[]
  vendors            Vendor[]
  maintenanceRecords MaintenanceRecord[]
  checklistTemplates ChecklistTemplate[]
  checklistInstances ChecklistInstance[]
  inspections        Inspection[]
  operationalTasks   OperationalTask[]
  devices            Device[]
  telemetryRecords   TelemetryRecord[]
  alertRules         AlertRule[]
  alerts             Alert[]
  geofences          Geofence[]
  geofenceEvents     GeofenceEvent[]
  deviceEvents       DeviceEvent[]
  marinas            Marina[]
  marinaVessels      MarinaVessel[]
  berthReservations  BerthReservation[]
  marinaServices     MarinaService[]
  marinaContracts    MarinaContract[]
  clubMembers        ClubMember[]
  membershipPlans    MembershipPlan[]
  clubEvents         ClubEvent[]
  clubServices       ClubService[]
  leads              Lead[]
  followUpTasks      FollowUpTask[]
  automationWorkflows AutomationWorkflow[]
  communicationTemplates CommunicationTemplate[]
  campaigns          Campaign[]
  customerFeedbacks  CustomerFeedback[]
  aiUsageLogs        AiUsageLog[]
  conciergeRequests  ConciergeRequest[]
  serviceRequests    ServiceRequest[]
  supportTickets     SupportTicket[]
  customerMessages   CustomerMessage[]
  publicReviews      PublicReview[]
  branches           Branch[]
  taxRules           TaxRule[]
  subscription       Subscription?
  privacyRequests    PrivacyRequest[]
  analyticsMetrics   AnalyticsMetric[]
  kpiDefinitions     KpiDefinition[]
  forecastRuns       ForecastRun[]
  executiveAlerts    ExecutiveAlert[]
  savedReports       SavedReport[]
  aiRecommendations  AiRecommendation[]

  @@map("organizations")
}

model Location {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  addressLine1   String       @map("address_line1")
  addressLine2   String?      @map("address_line2")
  city           String
  stateProvince  String?      @map("state_province")
  country        String
  postalCode     String?      @map("postal_code")
  latitude       Decimal?     @db.Decimal(10, 8)
  longitude      Decimal?     @db.Decimal(11, 8)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yachts         Yacht[]

  @@map("locations")
}

model User {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  email          String        @unique
  passwordHash   String        @map("password_hash")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  phoneNumber    String?       @map("phone_number")
  isActive       Boolean       @default(true) @map("is_active")
  emailVerified  Boolean       @default(false) @map("email_verified")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  userRoles            UserRoleAssignment[]
  statusHistoryChanges BookingStatusHistory[]
  auditLogs            AuditLog[]
  customers            Customer[]
  crewMembers          CrewMember[]
  reportedMaintenance  MaintenanceRecord[]
  conductedInspections Inspection[]
  assignedTasks        OperationalTask[]
  clubMembers          ClubMember[]
  assignedLeads        Lead[]
  assignedFollowUps    FollowUpTask[]
  aiUsageLogs          AiUsageLog[]

  @@map("users")
}

model Role {
  id             String  @id @default(uuid())
  organizationId String? @map("organization_id")
  name           String
  code           String
  description    String?
  isSystemRole   Boolean @default(false) @map("is_system_role")

  userRoles       UserRoleAssignment[]
  rolePermissions RolePermissionAssignment[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  category    String
  roles       RolePermissionAssignment[]

  @@map("permissions")
}

model UserRoleAssignment {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermissionAssignment {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Yacht {
  id                 String                 @id @default(uuid())
  organizationId     String                 @map("organization_id")
  name               String
  registrationNumber String?                @map("registration_number")
  make               String?
  model              String?
  yearBuilt          Int?                   @map("year_built")
  lengthFt           Decimal?               @map("length_ft") @db.Decimal(6, 2)
  capacityPassengers Int                    @map("capacity_passengers")
  cabins             Int                    @default(0)
  bathrooms          Int                    @default(0)
  homePortId         String?                @map("home_port_id")
  hourlyRate         Decimal                @map("hourly_rate") @db.Decimal(14, 2)
  dailyRate          Decimal                @map("daily_rate") @db.Decimal(14, 2)
  currency           Currency               @default(USD)
  isActive           Boolean                @default(true) @map("is_active")
  operationalStatus  YachtOperationalStatus @default(AVAILABLE) @map("operational_status")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  homePort           Location?           @relation(fields: [homePortId], references: [id])
  images             YachtImage[]
  availability       YachtAvailability[]
  bookings           Booking[]
  maintenanceRecords MaintenanceRecord[]
  checklistInstances ChecklistInstance[]
  inspections        Inspection[]
  operationalTasks   OperationalTask[]
  devices            Device[]
  telemetryRecords   TelemetryRecord[]
  alerts             Alert[]
  geofenceEvents     GeofenceEvent[]
  marinaVessels      MarinaVessel[]

  @@map("yachts")
}

model YachtImage {
  id           String   @id @default(uuid())
  yachtId      String   @map("yacht_id")
  storagePath  String   @map("storage_path")
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  yacht        Yacht    @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@map("yacht_images")
}

model YachtAvailability {
  id        String   @id @default(uuid())
  yachtId   String   @map("yacht_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  isBlocked Boolean  @default(true) @map("is_blocked")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  yacht     Yacht    @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@map("yacht_availability")
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  email          String
  phoneNumber    String?  @map("phone_number")
  nationality    String?
  passportNumber String?  @map("passport_number")
  vipStatus      Boolean  @default(false) @map("vip_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings     Booking[]
  marinaVessels      MarinaVessel[]
  berthReservations  BerthReservation[]
  marinaContracts    MarinaContract[]
  clubMembers        ClubMember[]
  leadActivities     LeadActivity[]
  followUpTasks      FollowUpTask[]
  preferences        CustomerPreference[]
  feedbacks          CustomerFeedback[]
  profile            CustomerProfile?
  conciergeRequests  ConciergeRequest[]
  serviceRequests    ServiceRequest[]
  supportTickets     SupportTicket[]
  eventWaitlists     EventWaitlist[]
  customerMessages   CustomerMessage[]
  publicReviews      PublicReview[]

  @@map("customers")
}

model Booking {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  bookingReference String        @unique @map("booking_reference")
  yachtId          String        @map("yacht_id")
  customerId       String        @map("customer_id")
  status           BookingStatus @default(INQUIRY)
  startTime        DateTime      @map("start_time")
  endTime          DateTime      @map("end_time")
  passengerCount   Int           @map("passenger_count")
  subtotalAmount   Decimal       @map("subtotal_amount") @db.Decimal(14, 2)
  taxAmount        Decimal       @default(0.00) @map("tax_amount") @db.Decimal(14, 2)
  discountAmount   Decimal       @default(0.00) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(14, 2)
  currency         Currency      @default(USD)
  specialRequests  String?       @map("special_requests")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yacht              Yacht               @relation(fields: [yachtId], references: [id])
  customer           Customer            @relation(fields: [customerId], references: [id])
  addons             BookingAddon[]
  statusLog          BookingStatusHistory[]
  payments           Payment[]
  invoices           Invoice[]
  documents          Document[]
  crewAssignments    CrewAssignment[]
  checklistInstances ChecklistInstance[]
  inspections        Inspection[]
  operationalTasks   OperationalTask[]
  berthReservations  BerthReservation[]

  @@map("bookings")
}

model BookingAddon {
  id          String   @id @default(uuid())
  bookingId   String   @map("booking_id")
  name        String
  category    String
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  quantity    Int      @default(1)
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_addons")
}

model BookingStatusHistory {
  id         String         @id @default(uuid())
  bookingId  String         @map("booking_id")
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  changedBy  String?        @map("changed_by")
  notes      String?
  createdAt  DateTime       @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [changedBy], references: [id])

  @@map("booking_status_history")
}

model Payment {
  id                    String        @id @default(uuid())
  organizationId        String        @map("organization_id")
  bookingId             String        @map("booking_id")
  paymentReference      String        @unique @map("payment_reference")
  provider              String        @default("STRIPE")
  providerTransactionId String?       @map("provider_transaction_id")
  amount                Decimal       @db.Decimal(14, 2)
  currency              Currency      @default(USD)
  status                PaymentStatus @default(PENDING)
  paymentMethod         String?       @map("payment_method")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  bookingId      String        @map("booking_id")
  invoiceNumber  String        @unique @map("invoice_number")
  subtotalAmount Decimal       @map("subtotal_amount") @db.Decimal(14, 2)
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0.00) @map("paid_amount") @db.Decimal(14, 2)
  currency       Currency      @default(USD)
  status         InvoiceStatus @default(ISSUED)
  dueDate        DateTime      @map("due_date")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id])

  @@map("invoices")
}

model Document {
  id           String   @id @default(uuid())
  bookingId    String   @map("booking_id")
  name         String
  documentType String   @map("document_type")
  storagePath  String   @map("storage_path")
  isSigned     Boolean  @default(false) @map("is_signed")
  createdAt    DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// -------------------------------------------------------------
// PHASE 2 OPERATIONAL MANAGEMENT MODELS
// -------------------------------------------------------------

model CrewMember {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  userId         String?    @map("user_id")
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  email          String
  phone          String?
  role           CrewRole   @default(DECKHAND)
  customRole     String?    @map("custom_role")
  nationality    String?
  status         CrewStatus @default(AVAILABLE)
  hireDate       DateTime?  @map("hire_date")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  availability   CrewAvailability[]
  assignments    CrewAssignment[]
  certifications CrewCertification[]
  licenses       CrewLicense[]
  documents      CrewDocument[]

  @@map("crew_members")
}

model CrewAvailability {
  id           String     @id @default(uuid())
  crewMemberId String     @map("crew_member_id")
  startTime    DateTime   @map("start_time")
  endTime      DateTime   @map("end_time")
  isBlocked    Boolean    @default(true) @map("is_blocked")
  reason       String?
  createdAt    DateTime   @default(now()) @map("created_at")
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@map("crew_availability")
}

model CrewAssignment {
  id           String     @id @default(uuid())
  bookingId    String     @map("booking_id")
  crewMemberId String     @map("crew_member_id")
  roleAssigned String     @map("role_assigned")
  startTime    DateTime   @map("start_time")
  endTime      DateTime   @map("end_time")
  status       String     @default("CONFIRMED")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@map("crew_assignments")
}

model CrewCertification {
  id               String     @id @default(uuid())
  crewMemberId     String     @map("crew_member_id")
  name             String
  issuingAuthority String?    @map("issuing_authority")
  certificateNumber String?   @map("certificate_number")
  issueDate        DateTime?  @map("issue_date")
  expiryDate       DateTime?  @map("expiry_date")
  documentUrl      String?    @map("document_url")
  status           CertStatus @default(VALID)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  crewMember       CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@map("crew_certifications")
}

model CrewLicense {
  id            String     @id @default(uuid())
  crewMemberId  String     @map("crew_member_id")
  name          String
  licenseNumber String?    @map("license_number")
  issuingAuthority String? @map("issuing_authority")
  issueDate     DateTime?  @map("issue_date")
  expiryDate    DateTime?  @map("expiry_date")
  documentUrl   String?    @map("document_url")
  status        CertStatus @default(VALID)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  crewMember    CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@map("crew_licenses")
}

model CrewDocument {
  id           String     @id @default(uuid())
  crewMemberId String     @map("crew_member_id")
  name         String
  documentType String     @map("document_type")
  storagePath  String     @map("storage_path")
  createdAt    DateTime   @default(now()) @map("created_at")
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@map("crew_documents")
}

model Vendor {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  category       String   @default("MAINTENANCE")
  contactName    String?  @map("contact_name")
  email          String?
  phone          String?
  location       String?
  services       String?
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  maintenance  MaintenanceRecord[]

  @@map("vendors")
}

model MaintenanceRecord {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  yachtId            String              @map("yacht_id")
  vendorId           String?             @map("vendor_id")
  inspectionId       String?             @map("inspection_id")
  title              String
  description        String
  priority           MaintenancePriority @default(MEDIUM)
  status             MaintenanceStatus   @default(REPORTED)
  isBlocking         Boolean             @default(false) @map("is_blocking")
  reportedById       String?             @map("reported_by_id")
  assignedVendorName String?             @map("assigned_vendor_name")
  dueDate            DateTime?           @map("due_date")
  completedDate      DateTime?           @map("completed_date")
  estimatedCost      Decimal?            @map("estimated_cost") @db.Decimal(14, 2)
  actualCost         Decimal?            @map("actual_cost") @db.Decimal(14, 2)
  currency           Currency            @default(USD)
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yacht        Yacht        @relation(fields: [yachtId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  inspection   Inspection?  @relation(fields: [inspectionId], references: [id])
  reportedBy   User?        @relation(fields: [reportedById], references: [id])

  @@map("maintenance_records")
}

model ChecklistTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  type           String   @default("PRE_CHARTER")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ChecklistTemplateItem[]
  instances    ChecklistInstance[]

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id          String            @id @default(uuid())
  templateId  String            @map("template_id")
  title       String
  description String?
  isRequired  Boolean           @default(true) @map("is_required")
  displayOrder Int              @default(0) @map("display_order")
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("checklist_template_items")
}

model ChecklistInstance {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  bookingId      String?         @map("booking_id")
  yachtId        String          @map("yacht_id")
  templateId     String          @map("template_id")
  assignedUserId String?         @map("assigned_user_id")
  status         ChecklistStatus @default(PENDING)
  completedAt    DateTime?       @map("completed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking?                @relation(fields: [bookingId], references: [id])
  yacht        Yacht                   @relation(fields: [yachtId], references: [id])
  template     ChecklistTemplate       @relation(fields: [templateId], references: [id])
  items        ChecklistInstanceItem[]

  @@map("checklist_instances")
}

model ChecklistInstanceItem {
  id          String              @id @default(uuid())
  instanceId  String              @map("instance_id")
  title       String
  result      ChecklistItemResult @default(PENDING)
  notes       String?
  completedBy String?             @map("completed_by")
  completedAt DateTime?           @map("completed_at")
  instance    ChecklistInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("checklist_instance_items")
}

model Inspection {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  yachtId          String           @map("yacht_id")
  bookingId        String?          @map("booking_id")
  inspectorUserId  String?          @map("inspector_user_id")
  type             InspectionType   @default(PRE_CHARTER)
  status           InspectionStatus @default(PENDING)
  notes            String?
  inspectionDate   DateTime         @default(now()) @map("inspection_date")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yacht              Yacht               @relation(fields: [yachtId], references: [id])
  booking            Booking?            @relation(fields: [bookingId], references: [id])
  inspector          User?               @relation(fields: [inspectorUserId], references: [id])
  items              InspectionItem[]
  maintenanceRecords MaintenanceRecord[]

  @@map("inspections")
}

model InspectionItem {
  id                 String               @id @default(uuid())
  inspectionId       String               @map("inspection_id")
  categoryName       String               @map("category_name")
  itemName           String               @map("item_name")
  result             InspectionItemResult @default(NOT_CHECKED)
  notes              String?
  maintenanceCreated Boolean              @default(false) @map("maintenance_created")
  inspection         Inspection           @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_items")
}

model OperationalTask {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  yachtId        String?             @map("yacht_id")
  bookingId      String?             @map("booking_id")
  assignedUserId String?             @map("assigned_user_id")
  title          String
  description    String?
  priority       TaskPriority        @default(MEDIUM)
  status         TaskStatus          @default(TODO)
  dueDate        DateTime?           @map("due_date")
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yacht        Yacht?       @relation(fields: [yachtId], references: [id])
  booking      Booking?     @relation(fields: [bookingId], references: [id])
  assignedUser User?        @relation(fields: [assignedUserId], references: [id])

  @@map("operational_tasks")
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  title          String
  message        String
  channel        String   @default("IN_APP")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  entityName     String   @map("entity_name")
  entityId       String   @map("entity_id")
  previousState  Json?    @map("previous_state")
  newState       Json?    @map("new_state")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}

// ==========================================
// PHASE 3 — SMART FLEET & IoT CONNECTED VESSELS
// ==========================================

enum DeviceType {
  GPS
  ENGINE
  FUEL
  BATTERY
  BILGE
  TEMPERATURE
  WATER_LEVEL
  OTHER
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  ERROR
  MAINTENANCE
}

enum MetricType {
  SPEED
  HEADING
  LATITUDE
  LONGITUDE
  FUEL_LEVEL
  BATTERY_VOLTAGE
  BATTERY_CHARGE
  ENGINE_RPM
  ENGINE_TEMP
  ENGINE_HOURS
  BILGE_STATUS
  TEMPERATURE
  WATER_LEVEL
  CUSTOM
}

enum TelemetryQuality {
  GOOD
  SUSPECT
  INVALID
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertCategory {
  DEVICE_OFFLINE
  HIGH_SPEED
  LOW_BATTERY
  LOW_FUEL
  HIGH_ENGINE_TEMPERATURE
  BILGE_ALERT
  GEOFENCE_EXIT
  GEOFENCE_ENTRY
  ABNORMAL_READING
  OTHER
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum GeofenceShape {
  CIRCLE
  POLYGON
}

enum GeofenceEventType {
  ENTRY
  EXIT
}

model Device {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  yachtId         String?      @map("yacht_id")
  deviceName      String       @map("device_name")
  deviceType      DeviceType   @default(GPS) @map("device_type")
  manufacturer    String?
  model           String?
  serialNumber    String?      @map("serial_number")
  firmwareVersion String?      @map("firmware_version")
  status          DeviceStatus @default(ACTIVE)
  lastSeenAt      DateTime?    @map("last_seen_at")
  installedAt     DateTime?    @map("installed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yacht        Yacht?              @relation(fields: [yachtId], references: [id])
  credentials  DeviceCredential?
  telemetry    TelemetryRecord[]
  alerts       Alert[]
  events       DeviceEvent[]

  @@map("devices")
}

model DeviceCredential {
  id          String   @id @default(uuid())
  deviceId    String   @unique @map("device_id")
  tokenHash   String   @map("token_hash")
  secretMask  String   @map("secret_mask")
  createdAt   DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_credentials")
}

model TelemetryRecord {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  yachtId        String           @map("yacht_id")
  deviceId       String           @map("device_id")
  timestamp      DateTime         @default(now())
  metricType     MetricType       @map("metric_type")
  value          Float
  unit           String           @default("unit")
  quality        TelemetryQuality @default(GOOD)
  source         String           @default("simulator")
  eventId        String?          @map("event_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yacht        Yacht        @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([organizationId, yachtId, timestamp])
  @@index([deviceId, timestamp])
  @@index([metricType, timestamp])
  @@map("telemetry_records")
}

model TelemetryAggregate {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  yachtId        String     @map("yacht_id")
  metricType     MetricType @map("metric_type")
  timeBucket     DateTime   @map("time_bucket")
  avgValue       Float      @map("avg_value")
  minValue       Float      @map("min_value")
  maxValue       Float      @map("max_value")
  sampleCount    Int        @map("sample_count")

  @@unique([yachtId, metricType, timeBucket])
  @@map("telemetry_aggregates")
}

model AlertRule {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  yachtId         String?       @map("yacht_id")
  deviceId        String?       @map("device_id")
  metricType      MetricType    @map("metric_type")
  operator        String        @default("<")
  threshold       Float
  severity        AlertSeverity @default(WARNING)
  category        AlertCategory @default(OTHER)
  isEnabled       Boolean       @default(true) @map("is_enabled")
  cooldownMinutes Int           @default(15) @map("cooldown_minutes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alerts       Alert[]

  @@map("alert_rules")
}

model Alert {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  yachtId          String        @map("yacht_id")
  deviceId         String?       @map("device_id")
  ruleId           String?       @map("rule_id")
  category         AlertCategory @default(OTHER)
  severity         AlertSeverity @default(WARNING)
  status           AlertStatus   @default(OPEN)
  title            String
  message          String
  metricType       MetricType?   @map("metric_type")
  metricValue      Float?        @map("metric_value")
  threshold        Float?
  triggerCount     Int           @default(1) @map("trigger_count")
  lastTriggeredAt  DateTime      @default(now()) @map("last_triggered_at")
  acknowledgedById String?       @map("acknowledged_by_id")
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  resolvedById     String?       @map("resolved_by_id")
  resolvedAt       DateTime?     @map("resolved_at")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yacht        Yacht        @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id])
  rule         AlertRule?   @relation(fields: [ruleId], references: [id])

  @@map("alerts")
}

model Geofence {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  yachtId        String?       @map("yacht_id")
  name           String
  description    String?
  shape          GeofenceShape @default(CIRCLE)
  centerLat      Float?        @map("center_lat")
  centerLng      Float?        @map("center_lng")
  radiusMeters   Float?        @map("radius_meters")
  polygonCoords  Json?         @map("polygon_coords")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       GeofenceEvent[]

  @@map("geofences")
}

model GeofenceEvent {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  yachtId        String            @map("yacht_id")
  deviceId       String?           @map("device_id")
  geofenceId     String            @map("geofence_id")
  eventType      GeofenceEventType @map("event_type")
  latitude       Float
  longitude      Float
  timestamp      DateTime          @default(now())
  createdAt      DateTime          @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yacht        Yacht        @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  geofence     Geofence     @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@map("geofence_events")
}

model DeviceEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  deviceId       String   @map("device_id")
  eventType      String   @map("event_type")
  payload        Json?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_events")
}

// ==========================================
// PHASE 4 — MARINA & YACHT CLUB MANAGEMENT
// ==========================================

enum MarinaStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  CLOSED
}

enum DockStatus {
  ACTIVE
  CLOSED
  MAINTENANCE
}

enum BerthStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum BerthReservationStatus {
  INQUIRY
  PENDING
  RESERVED
  CONFIRMED
  CHECK_IN
  OCCUPIED
  CHECK_OUT
  COMPLETED
  CANCELLED
}

enum ContractType {
  SHORT_TERM
  LONG_TERM
  SEASONAL
}

enum ContractStatus {
  DRAFT
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClubMemberStatus {
  ACTIVE
  PENDING
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum MembershipBillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ClubEventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Marina {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  description    String?
  address        String
  country        String
  city           String
  postalCode     String?      @map("postal_code")
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  website        String?
  operatingHours String?      @map("operating_hours")
  timezone       String       @default("UTC")
  currency       Currency     @default(USD)
  status         MarinaStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docks        Dock[]
  reservations BerthReservation[]
  contracts    MarinaContract[]

  @@map("marinas")
}

model Dock {
  id             String     @id @default(uuid())
  marinaId       String     @map("marina_id")
  name           String
  description    String?
  location       String?
  numberOfBerths Int        @default(0) @map("number_of_berths")
  status         DockStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  marina Marina  @relation(fields: [marinaId], references: [id], onDelete: Cascade)
  berths Berth[]

  @@map("docks")
}

model Berth {
  id             String      @id @default(uuid())
  dockId         String      @map("dock_id")
  berthNumber    String      @map("berth_number")
  maxLengthFt    Float       @map("max_length_ft")
  maxBeamFt      Float       @map("max_beam_ft")
  maxDraftFt     Float       @map("max_draft_ft")
  powerAvailable Boolean     @default(true) @map("power_available")
  waterAvailable Boolean     @default(true) @map("water_available")
  sewageService  Boolean     @default(false) @map("sewage_service")
  fuelService    Boolean     @default(false) @map("fuel_service")
  status         BerthStatus @default(AVAILABLE)
  pricePerNight  Float       @map("price_per_night")
  currency       Currency    @default(USD)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  dock         Dock               @relation(fields: [dockId], references: [id], onDelete: Cascade)
  reservations BerthReservation[]
  contracts    MarinaContract[]

  @@map("berths")
}

model MarinaVessel {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  yachtId               String?   @map("yacht_id")
  customerId            String?   @map("customer_id")
  vesselName            String    @map("vessel_name")
  registrationNumber    String?   @map("registration_number")
  type                  String?
  lengthFt              Float     @map("length_ft")
  beamFt                Float     @map("beam_ft")
  draftFt               Float     @map("draft_ft")
  homePort              String?   @map("home_port")
  insurancePolicyNumber String?   @map("insurance_policy_number")
  insuranceExpiry       DateTime? @map("insurance_expiry")
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yacht        Yacht?             @relation(fields: [yachtId], references: [id])
  customer     Customer?          @relation(fields: [customerId], references: [id])
  reservations BerthReservation[]
  contracts    MarinaContract[]

  @@map("marina_vessels")
}

model BerthReservation {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  marinaId       String                 @map("marina_id")
  berthId        String                 @map("berth_id")
  vesselId       String                 @map("vessel_id")
  customerId     String                 @map("customer_id")
  bookingId      String?                @map("booking_id")
  checkInDate    DateTime               @map("check_in_date")
  checkOutDate   DateTime               @map("check_out_date")
  status         BerthReservationStatus @default(RESERVED)
  totalAmount    Float                  @map("total_amount")
  currency       Currency               @default(USD)
  notes          String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marina       Marina                   @relation(fields: [marinaId], references: [id], onDelete: Cascade)
  berth        Berth                    @relation(fields: [berthId], references: [id], onDelete: Cascade)
  vessel       MarinaVessel             @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  customer     Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking      Booking?                 @relation(fields: [bookingId], references: [id])
  services     ReservationService[]
  checkins     MarinaCheckinCheckout[]

  @@map("berth_reservations")
}

model MarinaService {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  category       String
  pricingModel   String   @default("PER_NIGHT") @map("pricing_model")
  unitPrice      Float    @map("unit_price")
  currency       Currency @default(USD)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations ReservationService[]

  @@map("marina_services")
}

model ReservationService {
  id            String   @id @default(uuid())
  reservationId String   @map("reservation_id")
  serviceId     String   @map("service_id")
  quantity      Int      @default(1)
  totalPrice    Float    @map("total_price")
  createdAt     DateTime @default(now()) @map("created_at")

  reservation BerthReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  service     MarinaService    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("reservation_services")
}

model MarinaContract {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  marinaId       String         @map("marina_id")
  berthId        String         @map("berth_id")
  customerId     String         @map("customer_id")
  vesselId       String         @map("vessel_id")
  contractNumber String         @unique @map("contract_number")
  type           ContractType   @default(SHORT_TERM)
  startDate      DateTime       @map("start_date")
  endDate        DateTime       @map("end_date")
  price          Float
  currency       Currency       @default(USD)
  status         ContractStatus @default(ACTIVE)
  terms          String?
  documentUrl    String?        @map("document_url")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marina       Marina       @relation(fields: [marinaId], references: [id], onDelete: Cascade)
  berth        Berth        @relation(fields: [berthId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vessel       MarinaVessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)

  @@map("marina_contracts")
}

model MarinaCheckinCheckout {
  id              String   @id @default(uuid())
  reservationId  String   @map("reservation_id")
  actionType     String   @map("action_type") // CHECK_IN | CHECK_OUT
  timestamp      DateTime @default(now())
  conditionRating Int?     @map("condition_rating")
  conditionNotes String?  @map("condition_notes")
  staffUserId    String?  @map("staff_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  reservation BerthReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("marina_checkin_checkouts")
}

model ClubMember {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  customerId       String           @map("customer_id")
  userId           String?          @map("user_id")
  membershipNumber String           @unique @map("membership_number")
  planId           String           @map("plan_id")
  status           ClubMemberStatus @default(ACTIVE)
  joinDate         DateTime         @default(now()) @map("join_date")
  expiryDate       DateTime?        @map("expiry_date")
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id])
  plan         MembershipPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  events       EventRegistration[]

  @@map("club_members")
}

model MembershipPlan {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  name           String
  description    String?
  price          Float
  billingCycle   MembershipBillingCycle @default(ANNUAL) @map("billing_cycle")
  benefits       Json?
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ClubMember[]

  @@map("membership_plans")
}

model ClubEvent {
  id              String          @id @default(uuid())
  organizationId  String          @map("organization_id")
  name            String
  description     String?
  eventDate       DateTime        @map("event_date")
  startTime       String          @map("start_time")
  endTime         String          @map("end_time")
  location        String
  capacity        Int             @default(50)
  registeredCount Int             @default(0) @map("registered_count")
  price           Float           @default(0)
  status          ClubEventStatus @default(UPCOMING)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  eventWaitlists EventWaitlist[]

  @@map("club_events")
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  memberId     String   @map("member_id")
  status       String   @default("CONFIRMED")
  registeredAt DateTime @default(now()) @map("registered_at")
  notes        String?

  event  ClubEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("event_registrations")
}

model ClubService {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
