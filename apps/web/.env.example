# Vercel Environment Variables
# When you deploy this Next.js app to Vercel, you need to set this variable
# in your Vercel Project Dashboard (Settings -> Environment Variables).

# Point this to wherever you host your NestJS backend API (e.g., Render, Railway, DigitalOcean)
# Example: https://my-yacht-backend.onrender.com/api/v1
API_URL=http://127.0.0.1:4000/api/v1
